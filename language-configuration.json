{
  "comments": {
    "lineComment": "#"
  },
  "wordPattern": {
    "pattern": "[\\p{L}_][\\p{L}\\p{N}_'-]*",
    "flags": "u"
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"],
    ["\"", "\""]
  ]
}
