# The extension is bundled into out/extension.js (see esbuild.js), so we ship
# only that file plus assets — not node_modules or the per-module tsc output.
.vscode/**
.vscode-test/**
.github/**
src/**
test/**
scripts/**
out/**
!out/extension.js
node_modules/**
esbuild.js
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.gitignore
**/.gitkeep
*.vsix
